{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name"],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique beneficiary identifier"
      },
      "name": {
        "type": "string",
        "description": "Full name of the beneficiary"
      },
      "phone": {
        "type": "string",
        "description": "Phone number (optional)"
      },
      "email": {
        "type": "string",
        "format": "email",
        "description": "Email address (optional)"
      },
      "account_number": {
        "type": "string",
        "description": "Account number for bank transfers (optional)"
      }
    }
  }
}

