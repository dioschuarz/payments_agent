{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["code", "name"],
    "properties": {
      "code": {
        "type": "string",
        "description": "Delivery method code"
      },
      "name": {
        "type": "string",
        "description": "Human-readable name"
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Alternative names or variations"
      }
    }
  }
}

