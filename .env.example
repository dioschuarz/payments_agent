# Send Money Conversational Agent - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED - Core Configuration
# =============================================================================

# Google API Key for Gemini/ADK (required)
GOOGLE_API_KEY=your-google-api-key-here

# GCP Project ID (required for Firestore idempotency)
GCP_PROJECT_ID=your-gcp-project-id

# =============================================================================
# REQUIRED - Security Configuration
# =============================================================================

# Meta App Secret for webhook signature verification
# For demo/testing: use a temporary value like "chave-ficticia-123"
# For production: use the real secret from Facebook Developer Console
META_APP_SECRET=chave-ficticia-123

# Demo Access Code for demo requests
DEMO_ACCESS_CODE=WPP-DEMO

# =============================================================================
# OPTIONAL - Application Configuration
# =============================================================================

# Gemini Model to use (default: gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash-lite

# Environment name (dev/prd)
ENVIRONMENT=development

# Logging level (INFO/DEBUG/ERROR)
LOG_LEVEL=INFO

# =============================================================================
# OPTIONAL - Server Configuration
# =============================================================================

# Server host (default: 0.0.0.0)
HOST=0.0.0.0

# Server port (default: 8000)
PORT=8000

# =============================================================================
# OPTIONAL - Cache Configuration
# =============================================================================

# Session TTL in minutes (default: 30)
SESSION_TTL_MINUTES=30

# Intent cache TTL in hours (default: 1)
CACHE_TTL_INTENT_HOURS=1

# Beneficiary cache TTL in minutes (default: 30)
CACHE_TTL_BENEFICIARY_MINUTES=30

# Validation cache TTL in hours (default: 1)
CACHE_TTL_VALIDATION_HOURS=1

# =============================================================================
# OPTIONAL - ADK Retry Configuration (Local Development)
# =============================================================================
# These variables control the retry mechanism for Google ADK/Gemini API calls.
# For production, these are configured via GitHub Actions and passed to Terraform.

# Maximum number of retry attempts for ADK API calls (default: 5)
ADK_MAX_RETRIES=5

# Initial backoff delay in seconds before first retry (default: 0.5)
ADK_INITIAL_BACKOFF_SECONDS=0.5

# Maximum backoff delay in seconds between retries (default: 32.0)
ADK_MAX_BACKOFF_SECONDS=32.0

# Exponential backoff multiplier (default: 2.0)
ADK_BACKOFF_MULTIPLIER=2.0

# Enable/disable retry mechanism (default: true)
ADK_ENABLE_RETRY=true

# =============================================================================
# GitHub Actions Configuration (for CI/CD)
# =============================================================================
# 
# IMPORTANT: This project uses prefix-based naming (DEV_* and PRD_*) because
# the workflow accesses variables from both environments in the same workflow.
# Variables should be set at repository level (Settings → Environments → Variables)
# or in the respective environment (dev/prd) with the prefix.
#
# Configuration Steps:
# 1. Go to GitHub Repository → Settings → Environments
# 2. Create/Edit "dev" environment
# 3. Create/Edit "prd" environment
#
# For DEV Environment (set in "dev" environment or repository level):
#   - DEV_GCP_PROJECT_ID = <YOUR_PROJECT_ID>-dev
#   - DEV_GCP_REGION = us-central1
#   - DEV_GEMINI_MODEL = gemini-2.5-flash-lite
#   - DEV_LOG_LEVEL = INFO
#   - DEV_SESSION_TTL_MINUTES = 30
#   - DEV_CACHE_TTL_INTENT_HOURS = 1
#   - DEV_CACHE_TTL_BENEFICIARY_MINUTES = 30
#   - DEV_CACHE_TTL_VALIDATION_HOURS = 1
#   - DEV_ADK_MAX_RETRIES = 5
#   - DEV_ADK_INITIAL_BACKOFF_SECONDS = 0.5
#   - DEV_ADK_MAX_BACKOFF_SECONDS = 32.0
#   - DEV_ADK_BACKOFF_MULTIPLIER = 2.0
#   - DEV_ADK_ENABLE_RETRY = true
#
# For PRD Environment (set in "prd" environment or repository level):
#   - PRD_GCP_PROJECT_ID = <YOUR_PROJECT_ID>
#   - PRD_GCP_REGION = us-central1
#   - PRD_GEMINI_MODEL = gemini-2.5-flash
#   - PRD_LOG_LEVEL = INFO
#   - PRD_SESSION_TTL_MINUTES = 30
#   - PRD_CACHE_TTL_INTENT_HOURS = 1
#   - PRD_CACHE_TTL_BENEFICIARY_MINUTES = 30
#   - PRD_CACHE_TTL_VALIDATION_HOURS = 1
#   - PRD_ADK_MAX_RETRIES = 5
#   - PRD_ADK_INITIAL_BACKOFF_SECONDS = 0.5
#   - PRD_ADK_MAX_BACKOFF_SECONDS = 32.0
#   - PRD_ADK_BACKOFF_MULTIPLIER = 2.0
#   - PRD_ADK_ENABLE_RETRY = true
#
# NOTE: The GitHub Actions workflow converts these to TF_VAR_* format:
#   DEV_ADK_MAX_RETRIES → TF_VAR_adk_max_retries (for DEV)
#   PRD_ADK_MAX_RETRIES → TF_VAR_adk_max_retries (for PRD)
# Terraform then uses these values to set environment variables in Cloud Run.
#
# =============================================================================
# GitHub Actions Secrets (REQUIRED - sensitive data)
# =============================================================================
# Secrets should use the same prefix pattern (DEV_* and PRD_*) for consistency.
#
# For DEV Environment:
#   - WIF_PROVIDER_DEV
#   - WIF_SA_DEV
#   - DEV_GOOGLE_API_KEY
#   - DEV_META_APP_SECRET
#   - DEV_DEMO_ACCESS_CODE
#
# For PRD Environment:
#   - WIF_PROVIDER_PRD
#   - WIF_SA_PRD
#   - PRD_GOOGLE_API_KEY
#   - PRD_META_APP_SECRET
#   - PRD_DEMO_ACCESS_CODE
# =============================================================================
